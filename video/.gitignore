node_modules
dist
.DS_Store
.env

# Ignore the output video from Git but not videos you import into src/.
out

# Whisper.cpp binary + downloaded model (can be gigabytes, regenerated by
# `npm run transcribe`).
.whisper-cpp

# Raw source footage is too heavy to commit to git; keep it local /
# in Drive and only commit the folder structure + generated captions.
public/videos/*
!public/videos/.gitkeep
